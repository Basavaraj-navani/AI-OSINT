# Runtime environment: development, test, or production.
OSINT_ENVIRONMENT=development
OSINT_LOG_LEVEL=INFO
OSINT_LOG_FORMAT=console
OSINT_SERVICE_NAME=drug-trafficking-osint

# NLP preprocessing defaults. All values are validated during pipeline construction.
OSINT_NLP_MIN_TEXT_LENGTH=1
OSINT_NLP_MAX_TEXT_LENGTH=10000
OSINT_NLP_REMOVE_HTML=true
OSINT_NLP_REMOVE_URLS=true
OSINT_NLP_REMOVE_EMAILS=true
OSINT_NLP_LOWERCASE=true
OSINT_NLP_NORMALIZE_UNICODE=true
OSINT_NLP_NORMALIZE_MENTIONS=true
OSINT_NLP_NORMALIZE_USERNAMES=true
OSINT_NLP_REMOVE_PUNCTUATION=true
OSINT_NLP_REMOVE_NUMBERS=false
OSINT_NLP_REMOVE_STOPWORDS=true
OSINT_NLP_LEMMATIZE=true
OSINT_NLP_REJECT_UNSUPPORTED_LANGUAGES=true
OSINT_NLP_SUPPORTED_LANGUAGES=en,es,fr,de,pt
OSINT_NLP_PIPELINE_VERSION=1.0.0

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=osint_session
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=osint
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
